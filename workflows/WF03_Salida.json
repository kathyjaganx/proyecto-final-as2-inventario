    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nuevos_vencidos AS (\n  UPDATE prestamos\n  SET estado = 'VENCIDO'\n  WHERE estado = 'ACTIVO'\n    AND fecha_devolucion_real IS NULL\n    AND fecha_devolucion_esperada < CURRENT_DATE\n  RETURNING id_prestamo\n)\nSELECT\n  p.id_prestamo,\n  p.carne,\n  p.nombre_estudiante,\n  e.codigo                                        AS codigo_equipo,\n  e.nombre                                        AS equipo,\n  p.cantidad,\n  p.fecha_devolucion_esperada,\n  (CURRENT_DATE - p.fecha_devolucion_esperada)    AS dias_atraso,\n  p.id_prestamo IN (SELECT id_prestamo FROM nuevos_vencidos) AS vencido_hoy\nFROM prestamos p\nJOIN equipos e ON e.id_equipo = p.id_equipo\nWHERE p.fecha_devolucion_real IS NULL\n  AND p.fecha_devolucion_esperada < CURRENT_DATE\n  AND p.estado IN ('ACTIVO', 'VENCIDO')\nORDER BY dias_atraso DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -464,
        -144
      ],
      "id": "d1b45c02-eea0-46c4-b1aa-1ae2ba5a241f",
      "name": "Buscar vencidos",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "8qFZRzVVHhlPl7Lq",
          "name": "Postgres Inventario"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// =====================================================\n// WF3 - Generar reporte diario de préstamos vencidos\n// Autora: Irma Yaritza Katiuxca Jagan Xol - 4090-23-9748\n// =====================================================\n\n// Quitar el elemento vacío que llega cuando no hay vencidos\nconst filas = $input.all()\n  .map(item => item.json)\n  .filter(fila => fila.id_prestamo);\n\nconst hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Guatemala' });\nconst nuevosHoy = filas.filter(fila => fila.vencido_hoy).length;\n\nconst vencidos = filas.map(fila => ({\n  id_prestamo: fila.id_prestamo,\n  carne: fila.carne,\n  estudiante: fila.nombre_estudiante,\n  equipo: `${fila.codigo_equipo} - ${fila.equipo}`,\n  cantidad: fila.cantidad,\n  fecha_devolucion: String(fila.fecha_devolucion_esperada).slice(0, 10),\n  dias_atraso: Number(fila.dias_atraso)\n}));\n\nreturn [{\n  json: {\n    fecha_reporte: hoy,\n    total_vencidos: vencidos.length,\n    nuevos_vencidos_hoy: nuevosHoy,\n    mensaje: vencidos.length === 0\n      ? 'Sin prestamos vencidos'\n      : `Hay ${vencidos.length} prestamo(s) vencido(s)`,\n    vencidos\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
