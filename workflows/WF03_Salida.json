    {
      "parameters": {
        "jsCode": "// =====================================================\n// WF3 - Preparar filas para el archivo CSV\n// Autora: Irma Yaritza Katiuxca Jagan Xol - 4090-23-9748\n// =====================================================\n\nconst reporte = $input.first().json;\n\n// Si no hay vencidos, el archivo lleva una sola fila indicándolo\nif (reporte.total_vencidos === 0) {\n  return [{\n    json: {\n      fecha_reporte: reporte.fecha_reporte,\n      id_prestamo: '',\n      carne: '',\n      estudiante: 'Sin prestamos vencidos',\n      equipo: '',\n      cantidad: '',\n      fecha_devolucion: '',\n      dias_atraso: ''\n    }\n  }];\n}\n\n// Una fila por cada préstamo vencido\nreturn reporte.vencidos.map(vencido => ({\n  json: {\n    fecha_reporte: reporte.fecha_reporte,\n    ...vencido\n  }\n}));"
      },
