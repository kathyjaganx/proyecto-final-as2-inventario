    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH equipo AS (\n  UPDATE equipos\n  SET stock_disponible = stock_disponible - $2\n  WHERE codigo = $1\n    AND activo = TRUE\n    AND stock_disponible >= $2\n  RETURNING id_equipo, nombre, stock_disponible\n),\nnuevo AS (\n  INSERT INTO prestamos (carne, nombre_estudiante, id_equipo, cantidad, fecha_devolucion_esperada)\n  SELECT $3, $4, id_equipo, $2, $5::date\n  FROM equipo\n  RETURNING id_prestamo\n)\nSELECT\n  (SELECT COUNT(*) FROM equipo) > 0                                 AS aprobado,\n  (SELECT id_prestamo FROM nuevo)                                   AS id_prestamo,\n  (SELECT nombre FROM equipo)                                       AS equipo,\n  (SELECT stock_disponible FROM equipo)                             AS stock_restante,\n  EXISTS (SELECT 1 FROM equipos WHERE codigo = $1 AND activo = TRUE) AS equipo_existe,\n  (SELECT stock_disponible FROM equipos WHERE codigo = $1)          AS stock_antes;",
        "options": {
          "queryReplacement": "={{ $json.datos.codigo_equipo }},{{ $json.datos.cantidad }},{{ $json.datos.carne }},{{ $json.datos.nombre_estudiante }},{{ $json.datos.fecha_devolucion }}"
        }
      },
