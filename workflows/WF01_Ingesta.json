    {
      "parameters": {
        "jsCode": "// =====================================================\n// WF1 - Validar datos de la solicitud de préstamo\n// Autora: Irma Yaritza Katiuxca Jagan Xol - 4090-23-9748\n// =====================================================\n\nconst body = $input.first().json.body || {};\nconst errores = [];\n\n// Limpiar los datos recibidos\nconst carne = String(body.carne || '').trim();\nconst nombre = String(body.nombre_estudiante || '').trim();\nconst telefono = String(body.telefono || '').replace(/[\\s-]/g, '');\nconst codigo = String(body.codigo_equipo || '').trim().toUpperCase();\nconst cantidad = Number(body.cantidad);\nconst fecha = String(body.fecha_devolucion || '').trim();\n\n// 1. Carné: formato 0000-00-0000\nif (!/^\\d{4}-\\d{2}-\\d{3,6}$/.test(carne)) {\n  errores.push('Carné inválido. Formato esperado: 0000-00-0000');\n}\n\n// 2. Nombre: solo letras y espacios, de 3 a 100 caracteres\nif (!/^[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]{3,100}$/.test(nombre)) {\n  errores.push('Nombre inválido. Solo letras y espacios (3 a 100 caracteres)');\n}\n\n// 3. Teléfono: 8 dígitos (se aceptan espacios o guiones, que se eliminan)\nif (!/^\\d{8}$/.test(telefono)) {\n  errores.push('Teléfono inválido. Debe tener 8 dígitos');\n}\n\n// 4. Código de equipo: formato AAA-000\nif (!/^[A-Z]{3}-\\d{3}$/.test(codigo)) {\n  errores.push('Código de equipo inválido. Formato esperado: AAA-000');\n}\n\n// 5. Cantidad: número entero entre 1 y 10\nif (!Number.isInteger(cantidad) || cantidad < 1 || cantidad > 10) {\n  errores.push('Cantidad inválida. Debe ser un número entero entre 1 y 10');\n}\n\n// 6. Fecha de devolución: formato AAAA-MM-DD, desde hoy hasta 30 días\nconst hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Guatemala' });\nconst limite = new Date(hoy + 'T12:00:00Z');\nlimite.setUTCDate(limite.getUTCDate() + 30);\nconst fechaLimite = limite.toISOString().slice(0, 10);\n\nconst fechaValida =\n  /^\\d{4}-\\d{2}-\\d{2}$/.test(fecha) &&\n  new Date(fecha + 'T12:00:00Z').toISOString().slice(0, 10) === fecha;\n\nif (!fechaValida) {\n  errores.push('Fecha de devolución inválida. Formato esperado: AAAA-MM-DD');\n} else if (fecha < hoy || fecha > fechaLimite) {\n  errores.push(`La fecha de devolución debe estar entre ${hoy} y ${fechaLimite}`);\n}\n\nreturn [{\n  json: {\n    valido: errores.length === 0,\n    errores,\n    datos: {\n      carne,\n      nombre_estudiante: nombre,\n      telefono,\n      codigo_equipo: codigo,\n      cantidad,\n      fecha_devolucion: fecha\n    }\n  }\n}];"
      },
